# === Database ===
DATABASE_URL=postgresql://user:pass@host:5432/taxchain
# For local dev without PostgreSQL:
# DATABASE_URL=sqlite:///./taxchain.db

# === JWT ===
SECRET_KEY=your-jwt-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS ===
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# === Chain APIs ===
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
SOLSCAN_API_KEY=

# === Price APIs ===
COINGECKO_API_KEY=

# === Payments ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# === Plan IDs (set these after creating plans in your payment dashboards) ===
RAZORPAY_PLAN_STARTER=plan_starter_monthly
RAZORPAY_PLAN_PRO=plan_pro_monthly
LEMONSQUEEZY_VARIANT_STARTER=variant_starter_monthly
LEMONSQUEEZY_VARIANT_PRO=variant_pro_monthly
LEMONSQUEEZY_STORE_ID=1

# === Environment ===
# APP_ENV=dev|prod  (prod enables startup validations)
# DEBUG=false
